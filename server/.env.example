NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/studynest

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLIENT_URL=http://localhost:5173

# Optional — required only for AI features (summary/flashcards/quiz/chat).
# Without this, notes still upload/browse/view fine; aiStatus just stays "failed".
OPENAI_API_KEY=

# Optional — required only for note purchases (marketplace). Get test keys from
# the Razorpay dashboard. Without these, free notes and everything else work fine.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — required only for "forgot password" to actually send an email.
# Without these, reset links print to the server console instead (still fully testable).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StudyNest AI <no-reply@studynest.ai>

# Optional model overrides (defaults: gpt-4o-mini / text-embedding-3-small)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
